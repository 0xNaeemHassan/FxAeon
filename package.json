{
  "name": "FxAeon",
  "private": true,
  "workspaces": [
    "apps/mini-app"
  ],
  "scripts": {
    "build": "pnpm --dir apps/mini-app build",
    "dev": "pnpm --dir apps/mini-app dev",
    "lint": "eslint apps/mini-app/src",
    "lint:fix": "eslint apps/mini-app/src --fix",
    "test": "pnpm --dir apps/mini-app test",
    "test:chaos": "pnpm --dir apps/mini-app test:chaos",
    "test:anvil": "node scripts/run_anvil_tests.mjs --suite protocol",
    "test:anvil:earn": "node scripts/run_anvil_tests.mjs --suite earn",
    "test:anvil:stress": "node scripts/run_anvil_tests.mjs --suite stress",
    "test:anvil:all": "node scripts/run_anvil_tests.mjs --suite all",
    "test:anvil:browser": "node scripts/run_anvil_tests.mjs --suite browser",
    "test:stress": "pnpm test:chaos && pnpm test:anvil:stress",
    "test:e2e": "pnpm --dir apps/mini-app test:e2e",
    "typecheck": "pnpm --dir apps/mini-app typecheck && tsc -p apps/mini-app/e2e/fork/tsconfig.json",
    "verify:production-env": "node scripts/validate_production_env.mjs",
    "verify:scope": "node scripts/verify_fx_scope.mjs",
    "check:bundle": "node scripts/check_bundle_size.mjs",
    "docs:screenshots": "node scripts/capture_docs_screenshots.mjs",
    "docs:screenshots:positions": "node scripts/capture_position_screenshots.mjs",
    "verify": "node scripts/verify.mjs",
    "audit": "pnpm audit --prod --audit-level=high"
  },
  "engines": {
    "node": "22.x",
    "pnpm": "11.19.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "15.5.23",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.0",
    "wrangler": "4.127.0"
  },
  "packageManager": "pnpm@11.19.0",
  "version": "2.0.0"
}
