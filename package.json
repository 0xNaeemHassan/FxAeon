{
  "name": "FxAeon",
  "private": true,
  "workspaces": [
    "apps/mini-app"
  ],
  "scripts": {
    "build": "pnpm --dir apps/mini-app build",
    "dev": "pnpm --dir apps/mini-app dev",
    "lint": "eslint apps/mini-app/src",
    "lint:fix": "eslint apps/mini-app/src --fix",
    "test": "pnpm --dir apps/mini-app test",
    "test:e2e": "pnpm --dir apps/mini-app test:e2e",
    "typecheck": "pnpm --dir apps/mini-app typecheck",
    "verify:scope": "node scripts/verify_fx_scope.mjs",
    "check:bundle": "node scripts/check_bundle_size.mjs",
    "verify": "pnpm verify:scope && pnpm lint && pnpm typecheck && pnpm test && pnpm audit --prod --audit-level=high && pnpm build && pnpm check:bundle && node scripts/run_built_e2e.mjs",
    "audit": "pnpm audit --prod --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "15.5.23",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.0",
    "wrangler": "4.125.0"
  },
  "packageManager": "pnpm@11.19.0",
  "version": "2.0.0"
}
