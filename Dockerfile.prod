# Production Multi-Stage Dockerfile for FxAeon
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.16.0 --activate
WORKDIR /app

# Dependencies Stage
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY packages/db/prisma ./packages/db/prisma/
COPY apps/bot/package.json ./apps/bot/
COPY apps/mini-app/package.json ./apps/mini-app/

RUN pnpm install --frozen-lockfile

# Build Stage
FROM deps AS builder
COPY . .
RUN pnpm --filter @fxaeon/db db:generate
RUN pnpm --filter @fxaeon/shared build
RUN pnpm --filter @fxaeon/db build
RUN pnpm --filter @fxaeon/bot build
RUN pnpm --filter @fxaeon/mini-app build

# Production Runner Stage
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

# Create unprivileged user
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 fxaeon

COPY --from=builder --chown=fxaeon:nodejs /app /app

USER fxaeon

EXPOSE 3000 8080

CMD ["node", "apps/bot/dist/main.js"]
