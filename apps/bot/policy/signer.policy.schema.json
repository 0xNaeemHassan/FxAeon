{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fxaeon.local/schemas/signer.policy.schema.json",
  "title": "FxAeon declarative signer policy mirror",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "chainId", "description", "rules", "allowedTargets"],
  "properties": {
    "$schema": { "const": "./signer.policy.schema.json" },
    "version": { "type": "integer", "minimum": 1 },
    "chainId": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedTargetsOnly",
        "exactSelectorsOnly",
        "exactActionArguments",
        "arbitraryPayableValue",
        "approvals",
        "embeddedConversion",
        "cancellationSelfSend"
      ],
      "properties": {
        "allowedTargetsOnly": { "const": true },
        "exactSelectorsOnly": { "const": true },
        "exactActionArguments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "arbitraryPayableValue": { "const": false },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approve", "exactRouteAmount", "correlatedToLaterAction", "unlimited", "blanketPositionApproval"],
          "properties": {
            "approve": { "const": "0x095ea7b3" },
            "exactRouteAmount": { "const": true },
            "correlatedToLaterAction": { "const": true },
            "unlimited": { "const": false },
            "blanketPositionApproval": { "const": false }
          }
        },
        "embeddedConversion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "selector", "exactTokenAndAmount", "externalSignaturePayloads", "permittedSdkRoutes", "remoteAggregators"],
          "properties": {
            "target": { "$ref": "#/$defs/address" },
            "selector": { "const": "convert(address,uint256,uint256,uint256[])" },
            "exactTokenAndAmount": { "const": true },
            "externalSignaturePayloads": { "const": false },
            "permittedSdkRoutes": {
              "type": "array",
              "prefixItems": [{ "const": "FxRoute" }, { "const": "FxRoute 2" }],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "remoteAggregators": { "const": false }
          }
        },
        "cancellationSelfSend": { "const": "authenticated persisted replacement only" }
      }
    },
    "allowedTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "address"],
        "properties": {
          "label": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "address": { "$ref": "#/$defs/address" }
        }
      }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" }
  }
}
