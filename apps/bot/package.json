{
  "name": "@fxaeon/bot",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc && node scripts/copy-locales.cjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:fork": "vitest run --config vitest.fork.config.ts --configLoader runner",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "@aladdindao/fx-sdk": "1.0.5",
    "@fxaeon/db": "workspace:*",
    "@fxaeon/shared": "workspace:*",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/i18n": "^1.0.1",
    "@grammyjs/menu": "^1.2.0",
    "@grammyjs/runner": "^2.0.1",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@prisma/client": "^5.7.0",
    "@privy-io/chains": "^0.3.0",
    "@privy-io/server-auth": "^1.12.0",
    "@sentry/node": "^10.62.0",
    "cors": "^2.8.5",
    "dotenv": "16.6.1",
    "ethers": "^6.9.0",
    "express": "^4.19.0",
    "grammy": "^1.44.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "libsodium-wrappers": "^0.7.13",
    "node-cron": "^4.2.1",
    "openai": "^6.45.0",
    "pino": "^9.0.0",
    "prisma": "^5.7.0",
    "rate-limiter-flexible": "^11.2.0",
    "redis": "^6.0.0",
    "viem": "^2.53.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
