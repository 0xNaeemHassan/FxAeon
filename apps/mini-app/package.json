{
  "name": "@fxaeon/mini-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node ../../scripts/generate_csp_headers.mjs",
    "start": "node e2e/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:chaos": "tsx --test \"test/chaos.test.ts\"",
    "test:anvil": "tsx --test --test-concurrency=1 \"test/anvil.integration.test.ts\" \"test/earn.anvil.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@aladdindao/fx-sdk": "1.0.5",
    "@privy-io/react-auth": "3.30.0",
    "lucide-react": "0.554.0",
    "next": "15.5.23",
    "qrcode.react": "4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "viem": "2.53.1"
  },
  "devDependencies": {
    "@types/node": "20.19.42",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3",
    "tailwindcss": "3.4.17",
    "postcss": "8.5.23",
    "autoprefixer": "10.5.0",
    "@playwright/test": "1.61.0",
    "tsx": "4.22.4"
  }
}
