# FxAeon static Mini App configuration
#
# Copy this file to .env.local for development or configure the same public
# values in the Cloudflare Pages build. These values are shipped to the
# browser by design; never put a bot token, Privy secret, signing key, or
# unrestricted RPC credential in a NEXT_PUBLIC_* variable.

# Public Privy application identifier. The matching Privy application must
# allow the exact preview/production origins and only Ethereum + Base.
NEXT_PUBLIC_PRIVY_APP_ID=

# Browser RPC endpoints. Use distinct Alchemy applications for preview and
# production, restrict each key to its exact origins, enable only chain IDs
# 1 and 8453, and configure usage caps/alerts in Alchemy.
NEXT_PUBLIC_ALCHEMY_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_DOMAIN_RESTRICTED_KEY
NEXT_PUBLIC_ALCHEMY_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_DOMAIN_RESTRICTED_KEY

# Public Telegram launcher URL used by the browser landing page. Production
# deploys validate that this is an https://t.me/... Mini App URL. It is not an
# authentication or transaction-authority boundary.
NEXT_PUBLIC_TELEGRAM_APP_URL=https://t.me/FxAeonBot/app
